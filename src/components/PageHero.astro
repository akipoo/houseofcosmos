---
const { title, intro, crumb, eyebrow } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <div class="crumbs"><a href="/">Home</a> / {crumb || title}</div>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
    <slot />
  </div>
</section>
