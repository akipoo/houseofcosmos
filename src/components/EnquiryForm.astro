---
const { title = 'Book a Site Visit', subtitle = 'Share your details and our sales team will call you back.', project = 'Trividh', source = '', compact = false } = Astro.props;
---
<form class="enquiry" name="enquiry" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value="enquiry" />
  <input type="hidden" name="page" value={source || Astro.url.pathname} />
  <p class="hp"><label>Leave this empty <input name="bot-field" /></label></p>
  {!compact && <div><h3 style="margin-bottom:.25rem">{title}</h3><p style="color:var(--muted);margin:0;font-size:.95rem">{subtitle}</p></div>}
  <label>Full name<input name="name" type="text" required autocomplete="name" /></label>
  <div class="row">
    <label>Mobile number<input name="phone" type="tel" required autocomplete="tel" pattern="[0-9+\s\-]{8,15}" /></label>
    <label>Email<input name="email" type="email" autocomplete="email" /></label>
  </div>
  <div class="row">
    <label>Interested in
      <select name="configuration">
        <option>2 BHK</option><option>3 BHK</option><option>Jodi / Custom</option><option>Not sure yet</option>
      </select>
    </label>
    <label>Project
      <select name="project">
        <option selected={project === 'Trividh'}>Trividh</option>
        <option selected={project === 'Upcoming'}>Upcoming projects</option>
        <option selected={project === 'General'}>General enquiry</option>
      </select>
    </label>
  </div>
  <label>Message (optional)<textarea name="message" rows="3"></textarea></label>
  <label class="consent"><span><input type="checkbox" name="consent" required style="width:auto;margin-right:.4rem" />I agree to be contacted by House of Cosmos by call, SMS, WhatsApp or email.</span></label>
  <button class="btn btn-gold" type="submit">Request a call back →</button>
</form>
