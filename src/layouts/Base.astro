---
import '../styles/global.css';
import EnquiryForm from '../components/EnquiryForm.astro';
import { nav, premiumLinks, contact } from '../data/site.js';
import M from '../data/media.json';
const { title, description, ogImage = '/media/hero-poster.jpg', schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const org = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: 'House of Cosmos',
  url: 'https://houseofcosmos.co/',
  telephone: '+91-9920279296',
  email: contact.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Arihant Building, 201, Agyari Lane, Tembhi Naka, Thane West', addressLocality: 'Thane', addressRegion: 'Maharashtra', postalCode: '400601', addressCountry: 'IN' },
  openingHours: 'Mo-Su 09:00-20:00',
  sameAs: Object.values(contact.social),
};
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="House of Cosmos" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0c1222" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Afacad:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <div class="topbar"><div class="container">
    <span class="hide-sm">Open every day · 9 AM – 8 PM</span>
    <span><a href={contact.phoneHref}>{contact.phone}</a> &nbsp;·&nbsp; <a href={`mailto:${contact.email}`}>{contact.email}</a></span>
  </div></div>
  <header class="site">
    <div class="container">
      <a class="logo" href="/" aria-label="House of Cosmos home"><img src={M.logo} alt="House of Cosmos" width="180" height="46" /></a>
      <nav class="main" id="nav" aria-label="Primary">
        <ul>{nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}</ul>
      </nav>
      <button class="btn btn-gold header-cta" data-enquire>Enquire Now</button>
      <button class="menu-btn" aria-label="Open menu" aria-controls="nav" aria-expanded="false" id="menuBtn">☰</button>
    </div>
  </header>

  <main id="content"><slot /></main>

  <footer class="site">
    <div class="container">
      <div class="fgrid">
        <div>
          <a class="logo" href="/"><img src={M.logoAlt} alt="House of Cosmos" width="210" height="54" loading="lazy" /></a>
          <p style="margin-top:1.2rem">House of Cosmos stands for innovation, design, and sustainable living — Designed for Tomorrow. Rooted in Legacy.</p>
          <div class="social">
            <a href={contact.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">f</a>
            <a href={contact.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">ig</a>
            <a href={contact.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
          </div>
        </div>
        <div><h4>Our Menu</h4><ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>
        <div><h4>Explore Premium Living</h4><ul>{premiumLinks.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>
        <div>
          <h4>Visit Us</h4>
          <p><a href={contact.map} target="_blank" rel="noopener">{contact.address}</a></p>
          <p><strong style="color:#fff">Head & Sales Office</strong><br />{contact.hours}</p>
          <p><a href={contact.phoneHref}>{contact.phone}</a><br /><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        </div>
      </div>
      <div class="copy">
        <span>© {new Date().getFullYear()} House of Cosmos. All rights reserved.</span>
        <span>Trividh · MahaRERA No. P51700077697 · <a href="https://maharera.maharashtra.gov.in" target="_blank" rel="noopener">maharera.maharashtra.gov.in</a></span>
      </div>
    </div>
  </footer>

  <div class="actionbar">
    <a href={contact.phoneHref}>Call</a>
    <a class="wa" href={contact.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
    <button class="enq" data-enquire>Enquire</button>
  </div>
  <a class="wa-float" href={contact.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
  </a>

  <dialog class="modal" id="enqModal">
    <button class="close" aria-label="Close" data-close>×</button>
    <div class="inner">
      <h3 style="margin-bottom:.2rem">Quick Enquiry</h3>
      <p style="color:var(--muted);font-size:.95rem">Leave your details and we’ll call you back.</p>
      <EnquiryForm compact source={`${path} (popup)`} />
    </div>
  </dialog>

  <script>
    const btn = document.getElementById('menuBtn');
    const nav = document.getElementById('nav');
    btn?.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    const modal = document.getElementById('enqModal') as HTMLDialogElement;
    document.querySelectorAll('[data-enquire]').forEach((el) => el.addEventListener('click', () => modal.showModal()));
    modal.querySelector('[data-close]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  </script>
</body>
</html>
